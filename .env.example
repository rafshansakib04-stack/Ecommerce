# Water Purifier ERP - Environment Configuration
# Copy this file to .env and update the values

# Environment (local/production)
APP_ENV=local

# Database Configuration
DB_HOST=localhost
DB_NAME=water_purifier_erp
DB_USER=root
DB_PASS=

# Firebase Configuration (Optional)
FIREBASE_PROJECT_ID=water-purifier-erp
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_AUTH_DOMAIN=water-purifier-erp.firebaseapp.com
FIREBASE_DATABASE_URL=https://water-purifier-erp-default-rtdb.firebaseio.com/

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@yourdomain.com

# SMS Configuration (Optional)
SMS_PROVIDER=twilio
SMS_ACCOUNT_SID=your-twilio-account-sid
SMS_AUTH_TOKEN=your-twilio-auth-token
SMS_FROM_NUMBER=+1234567890